# Gemini API keys - use placeholders only
LLM_API_KEYS=your_gemini_key_1,your_gemini_key_2

# Working model configuration
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Local SQLite database
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Frontend development and Docker origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Failure simulation for testing
ENABLE_FAILURE_SIMULATION=true

# Default assistant prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, accurate assistant.
